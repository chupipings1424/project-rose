+"""Tests for deleting a whole title and a whole budget year.
+
+    python -m unittest test_delete -v
+
+Every test uses a temp workbook, never the real payments.xlsx.
+"""
+
+from __future__ import annotations
+
+import inspect
+import os
+import tempfile
+import unittest
+from unittest import mock
+from datetime import date
+
+from openpyxl import load_workbook
+
+import budget_db as budget
+import excel_db as db
+
+
+def _default_path(fn, path):
+    """Wrap `fn` so it uses `path` unless the caller passed one explicitly."""
+    signature = inspect.signature(fn)
+
+    def wrapper(*args, **kwargs):
+        bound = signature.bind_partial(*args, **kwargs)
+        bound.arguments.setdefault("path", path)
+        return fn(*bound.args, **bound.kwargs)
+
+    return wrapper
+
+
+class TempWorkbookTestCase(unittest.TestCase):
+    def setUp(self):
+        handle, self.path = tempfile.mkstemp(suffix=".xlsx")
+        os.close(handle)
+        os.remove(self.path)
+        db.create_workbook(self.path)
+
+    def tearDown(self):
+        if os.path.exists(self.path):
+            os.remove(self.path)
+
+    def plan(self, title, instalments=3):
+        db.create_account_with_schedule(
+            title=title,
+            amount=300,
+            instalments=instalments,
+            frequency="Monthly",
+            start_date=date(2026, 1, 1),
+            amount_mode="total",
+            path=self.path,
+        )
+
+
+class DeleteAccountTests(TempWorkbookTestCase):
+    def test_removes_title_and_all_its_payments_only(self):
+        self.plan("Car Loan", 3)
+        self.plan("Phone", 2)
+        db.add_payment("Car Loan", 50, date(2026, 2, 1), "9:00am", path=self.path)
+
+        removed = db.delete_account("car loan", self.path)  # case-insensitive
+
+        self.assertEqual(removed, 4)
+        self.assertEqual([a["title"] for a in db.read_accounts(self.path)], ["Phone"])
+        self.assertEqual(db.read_payments("Car Loan", self.path), [])
+        self.assertEqual(len(db.read_payments("Phone", self.path)), 2)
+
+    def test_missing_title_returns_none_and_changes_nothing(self):
+        self.plan("Phone", 2)
+        self.assertIsNone(db.delete_account("Nope", self.path))
+        self.assertIsNone(db.delete_account("  ", self.path))
+        self.assertEqual(len(db.read_payments(path=self.path)), 2)
+
+
+class DeleteYearTests(TempWorkbookTestCase):
+    def add(self, item, year):
+        return budget.add_line("Expense", "Home", item, year, [10] * 12, path=self.path)
+
+    def test_removes_only_that_year_and_its_report_sheet(self):
+        self.add("Rent", 2024)
+        self.add("Power", 2024)
+        self.add("Rent", 2025)
+
+        self.assertEqual(budget.delete_year(2024, self.path), 2)
+
+        self.assertNotIn(2024, budget.list_years(self.path))
+        self.assertEqual(budget.read_budget(2025, self.path)["line_count"], 1)
+        sheets = load_workbook(self.path).sheetnames
+        self.assertNotIn("Budget 2024", sheets)
+        self.assertIn("Budget 2025", sheets)
+
+    def test_empty_year_returns_zero(self):
+        self.add("Rent", 2025)
+        self.assertEqual(budget.delete_year(2030, self.path), 0)
+        self.assertEqual(budget.read_budget(2025, self.path)["line_count"], 1)
+
+    def test_invalid_year_raises(self):
+        with self.assertRaises(ValueError):
+            budget.delete_year("abc", self.path)
+
+
+class DeleteEndpointTests(TempWorkbookTestCase):
+    def setUp(self):
+        super().setUp()
+        import app as app_module
+
+        # Route the HTTP layer's storage calls to the temp workbook.
+        targets = [(db, "delete_account"), (db, "read_accounts"), (budget, "delete_year"), (budget, "read_budget")]
+        for module, name in targets:
+            patcher = mock.patch.object(module, name, _default_path(getattr(module, name), self.path))
+            patcher.start()
+            self.addCleanup(patcher.stop)
+        self.client = app_module.app.test_client()
+
+    def test_delete_account_endpoint(self):
+        self.plan("Car Loan", 2)
+        response = self.client.delete("/api/accounts/Car%20Loan")
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.get_json()["deleted_payments"], 2)
+        self.assertEqual(response.get_json()["accounts"], [])
+        self.assertEqual(self.client.delete("/api/accounts/Car%20Loan").status_code, 404)
+
+    def test_delete_year_endpoint(self):
+        budget.add_line("Expense", "Home", "Rent", 2024, [10] * 12, path=self.path)
+        response = self.client.delete("/api/budget/years/2024")
+        self.assertEqual(response.status_code, 200)
+        body = response.get_json()
+        self.assertEqual(body["deleted"], 1)
+        self.assertNotIn(2024, body["budget"]["years"])
+        self.assertEqual(self.client.delete("/api/budget/years/2024").status_code, 404)
+
+
+if __name__ == "__main__":
+    unittest.main()
