@@ -452,6 +452,38 @@ def delete_payment(payment_id, path=WORKBOOK_PATH):
     return False
 
 
+def _delete_matching_rows(ws, column_index, title_key):
+    """Delete every data row whose cell in `column_index` matches the title (case-insensitive).
+
+    Rows are removed bottom-up so earlier row numbers stay valid.
+    """
+    rows = [
+        row[column_index].row
+        for row in ws.iter_rows(min_row=2)
+        if row[column_index].value is not None
+        and str(row[column_index].value).strip().lower() == title_key
+    ]
+    for row_number in reversed(rows):
+        ws.delete_rows(row_number, 1)
+    return len(rows)
+
+
+def delete_account(title, path=WORKBOOK_PATH):
+    """Delete a title and every payment recorded under it, in one save.
+
+    Returns the number of payments removed, or None when the title does not exist.
+    """
+    title_key = (title or "").strip().lower()
+    if not title_key:
+        return None
+    wb = load(path)
+    if not _delete_matching_rows(wb[ACCOUNTS_SHEET], 0, title_key):
+        return None
+    removed_payments = _delete_matching_rows(wb[PAYMENTS_SHEET], 1, title_key)
+    _save(wb, path)
+    return removed_payments
+
