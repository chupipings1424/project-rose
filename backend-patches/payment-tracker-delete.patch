+def delete_year(year, path=WORKBOOK_PATH):
+    """Delete every budget line for `year` in one save; returns how many were removed."""
+    year = _to_int(year, 0)
+    if year <= 0:
+        raise ValueError("A valid year is required.")
+    wb = load(path)
+    ws = _ensure_sheet(wb)
+    rows = []
+    for row in ws.iter_rows(min_row=2):
+        line = _row_to_line(tuple(cell.value for cell in row))
+        # Match on the parsed year so blank-year rows (shown as the current year) are included.
+        if line is not None and line["year"] == year:
+            rows.append(row[COL_ID - 1].row)
+    if not rows:
+        return 0
+    for row_number in reversed(rows):
+        ws.delete_rows(row_number, 1)
+    _commit(wb, path, year)
+    return len(rows)
+
