# Copy this file to .env and fill in your own values.
# The access token is NOT here any more: it lives in the API, in
# project-rose-api/src/Rose.Api/appsettings.Local.json (see that repo's README).

# Where the ROSE API (.NET backend) answers. Vite forwards /api/* to it.
ROSE_API_URL=http://127.0.0.1:5175
# Where the project-rose-api repo is cloned (default: next to this folder).
# ROSE_API_DIR=C:\path\to\project-rose-api

# Where npm run package (package-rose.cmd) puts ROSE.exe (default: a ROSE folder next to this one).
# ROSE_PACKAGE_DIR=C:\path\to\ROSE

# Set to 1 to stop npm start from opening the browser.
# ROSE_NO_OPEN=1