# Copy this file to .env and fill in your own values.

# The access token for the login page.
VITE_ROSE_TOKEN=change-me

# Where the Payment Tracker (Flask) server lives.
PAYMENT_TRACKER_URL=http://127.0.0.1:5174
PAYMENT_TRACKER_DIR=C:\path\to\payment-tracker
# Reminders worker (server/index.ts). npm start launches it for you.
REMINDERS_PORT=5176
# Optional: where reminders.json, push-devices.json and the push keys are kept (default server/data).
# REMINDERS_DATA_DIR=C:\path\to\rose-data
# Shown to Apple/Google push services as the sender contact (mailto: or https URL).
ROSE_PUSH_CONTACT=https://github.com/chupipings1424/project-rose
# Set to 1 to turn off the always-on-top Windows popup.
# NO_NATIVE_ALARM=1
# One-time import from the old To-Do & Alarms app (only when server/data/reminders.json does not exist yet).
# TODO_APP_DIR=C:\path\to\todo-app